+def resolve_spawn_point(world, args):
+    """The ego spawn transform.
+
+	--spawn-pose x y z roll pitch yaw (CARLA frame, degrees for the rotation)
+	is exact and is what a committed benchmark route needs: its spawn pose is
+	generally NOT a member of the map's spawn-point list, and the extension
+	runner takes the same six numbers as --initial-pose, so both approaches
+	consume one route file identically.
+	--spawn-index picks the n-th entry of the map's own list (deterministic
+	instead of random, without pinning coordinates).
+	Neither given: random.choice over that list, exactly as before -- so the
+	default behaviour, including the "No spawn points available" refusal, is
+	unchanged."""
+
+    if args.spawn_pose is not None:
+        x, y, z, roll, pitch, yaw = args.spawn_pose
+        return carla.Transform(carla.Location(x=x, y=y, z=z),
+                               carla.Rotation(roll=roll, pitch=pitch, yaw=yaw))
+
+    try:
+        spawn_points = world.get_ego_spawn_points()
+    except AttributeError:
+        # Fallback when get_ego_spawn_points is not available (e.g. standard carla package)
+        spawn_points = world.get_map().get_spawn_points()
+    if not spawn_points:
+        raise RuntimeError("No spawn points available. Load a map that provides spawn points.")
+
+    if args.spawn_index is not None:
+        if not 0 <= args.spawn_index < len(spawn_points):
+            raise RuntimeError(
+                f"--spawn-index {args.spawn_index} is out of range: this map has "
+                f"{len(spawn_points)} spawn points."
+            )
+        return spawn_points[args.spawn_index]
+
+    return random.choice(spawn_points)
+
+
+def load_substep_config(path):
+    """Read {max_substep_delta_time, max_substeps} from a YAML file.
+
+	The harness passes benchmarks/config/physics.yaml -- the same file the
+	extension runner's own --substep-config reads -- which is what makes the
+	two approaches' physics substepping comparable rather than coincidental.
+	BOTH keys are required: a partial file would silently leave one of the
+	pair at this script's default and report a parity that does not hold."""
+
+    import yaml  # only needed with --substep-config
+
+    with open(path) as handle:
+        doc = yaml.safe_load(handle) or {}
+    config = {}
+    for key, cast in (("max_substep_delta_time", float), ("max_substeps", int)):
+        value = doc.get(key)
+        if value is None:
+            raise RuntimeError(
+                f"--substep-config {path}: '{key}' is missing or null. It needs "
+                "both max_substep_delta_time and max_substeps, or omit the flag "
+                "to keep this script's own defaults."
+            )
+        config[key] = cast(value)
+    return config
+
