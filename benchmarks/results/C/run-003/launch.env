LAUNCH_CELL="C"
APPROACH="extension"
LAUNCH_MAP="NishishinjukuMap"
LAUNCH_ARM="static"
RUN_MODE="editor-game"
CARLA_TREE="/home/youtalk/src/carla-autoware-integration"
CARLA_RPC_PORT="2000"
CARLA_PID_FILE="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/C/run-003/run_e2e.pid"
