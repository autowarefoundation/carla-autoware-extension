# Written by benchmarks/cells/tier4-native.sh (up).
LAUNCH_CELL="B"
APPROACH="tier4-native"
LAUNCH_MAP="Town10HD_Opt"
LAUNCH_ARM="static"
RUN_MODE="editor-game"
CARLA_TREE="/home/youtalk/src/carla-autoware-native"
CARLA_RPC_PORT="2000"
CARLA_PID_FILE="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/B/run-017/carla.pid"
LAUNCH_LOG="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/B/run-017/launch.log"
AW_CONTAINER="autoware"
AW_EXEC="docker exec -e ROS_DOMAIN_ID=0 autoware"
AW_SETUP="source /opt/ros/humble/setup.bash && source /opt/autoware/setup.bash && export ROS_DOMAIN_ID=0"
AW_COMPOSE=""
GT_ENABLED="1"
GT_CMD="env PYTHONPATH=/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0 /home/youtalk/carla-tier4-venv/bin/python3 -m benchmarks.scripts.collect_gt"
GT_OUT_DIR="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/B/run-017"
GT_COUNT_LIDAR="1"
INJECTOR_ENABLED="1"
ARM_ENABLED="1"
EXTRA_CONTAINERS=""
TIER4_DEMO="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/cells/tier4_autoware.sh"
# Declared for teardown.sh, which stops the demo BEFORE the editor: the demo
# drives world.tick(), and a client left ticking a dead server hangs on actor
# destroy. Written by the plan step too, so a launcher that dies half-way
# through the up step still leaves teardown something to stop.
TIER4_DEMO_PID_FILE="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/B/run-017/tier4_demo.pid"
