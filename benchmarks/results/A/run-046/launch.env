# Written by benchmarks/cells/extension.sh (up) -- sourced by run.sh and
# teardown.sh. Every value is resolved, never re-derived downstream.
LAUNCH_CELL="A"
APPROACH="extension"
LAUNCH_MAP="Town10HD_Opt"
LAUNCH_ARM="paced"
RUN_MODE="editor-game"
CARLA_TREE="/home/youtalk/src/carla-autoware-integration"
CARLA_RPC_PORT="2000"
CARLA_PID_FILE="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/A/run-046/run_e2e.pid"
LAUNCH_LOG="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/A/run-046/launch.log"
EDITOR_LOG="/tmp/carla-e2e.log"
AW_CONTAINER="autoware"
AW_EXEC="docker exec -e ROS_DOMAIN_ID=0 autoware"
AW_SETUP="source /opt/ros/humble/setup.bash && source /opt/autoware/setup.bash && export ROS_DOMAIN_ID=0"
AW_COMPOSE="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/docker/compose.yaml"
GT_ENABLED="1"
GT_CMD="env PYTHONPATH=/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0 /home/youtalk/carla-venv/bin/python3 -m benchmarks.scripts.collect_gt"
GT_OUT_DIR="/home/youtalk/src/carla-autoware-extension-worktrees/bench-p0/benchmarks/results/A/run-046"
GT_COUNT_LIDAR="1"
INJECTOR_ENABLED="1"
ARM_ENABLED="1"
EXTRA_CONTAINERS=""
SPAWN_ARGS="--initial-pose 55.33 141.161 0.5 0 0 0.32"
